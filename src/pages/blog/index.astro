---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import SplitText from '../../components/SplitText.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章列表 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="blog-index">
			<section class="index-head">
				<p class="index-eyebrow">
					ARTICLES
					<img
						class="index-deco"
						src="/images/blog-title-deco.png"
						alt=""
						loading="lazy"
						decoding="async"
					/>
				</p>
				<h1 class="index-title">文章列表</h1>
				<p class="index-sub">按顺序跟着做，一步步把环境跑起来。</p>
			</section>

			<ul class="post-list">
				{
					posts.map((post, index) => (
						<li class="post-item reveal">
							<a href={`/blog/${post.id}/`}>
								<span class="post-index">{String(index + 1).padStart(2, '0')}</span>
								<div class="post-body">
									<h4 class="post-title">
										<SplitText as="span" variant="rise" text={post.data.title} />
									</h4>
									<p class="post-date"><FormattedDate date={post.data.pubDate} /></p>
									{post.data.description && <p class="post-desc">{post.data.description}</p>}
								</div>
								<span class="post-arrow">→</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
		<script>
			const targets = document.querySelectorAll('.reveal');
			targets.forEach((t) => t.classList.add('is-visible'));
			const observer =
				'IntersectionObserver' in window
					? new IntersectionObserver(
							(entries) => {
								entries.forEach((entry) => {
									if (entry.isIntersecting) {
										entry.target.classList.add('is-visible');
										observer.unobserve(entry.target);
									}
								});
							},
							{ threshold: 0.12 },
						)
					: null;
			targets.forEach((t) => observer?.observe(t));
		</script>
	</body>
	<style>
		main.blog-index {
			width: min(960px, calc(100% - 2em));
			max-width: 100%;
			margin: 0 auto;
			padding: 0 0 4em;
		}
		.index-head {
			padding: clamp(3rem, 8vh, 5.5rem) 0 2.5rem;
			border-bottom: 1px solid var(--border);
		}
		.index-eyebrow {
			margin: 0 0 1rem;
			font-size: 0.8rem;
			letter-spacing: 0.28em;
			text-transform: uppercase;
			color: var(--accent);
			position: relative;
			display: inline-block;
		}
		.index-head h1 {
			margin: 0;
			font-size: clamp(2.2rem, 5.5vw, 3.6rem);
			line-height: 1.05;
			letter-spacing: -0.02em;
		}
		/* 眉标顶部的角标图标：位于 ARTICLES 文字顶部 */
		.index-deco {
			position: absolute;
			top: -16px;
			right: -30px;
			width: 34px;
			height: auto;
			opacity: 0.7;
			transform: rotate(8deg);
			border: none; /* 覆盖全局 img 边框 */
			box-shadow: none; /* 覆盖全局 img 阴影 */
			border-radius: 0;
		}
		.index-sub {
			margin: 1.2rem 0 0;
			font-size: 1.05rem;
			color: #6b5638;
		}
		.post-list {
			list-style: none;
			margin: 0;
			padding: 0;
		}
		.post-item {
			border-bottom: 1px solid var(--border);
		}
		.post-item a::before {
			inset: 16px 48px;
		}
		.post-item a {
			display: grid;
			grid-template-columns: 3rem minmax(0, 1fr) auto;
			align-items: center;
			gap: 1.2rem;
			padding: 1.8rem 0.4rem;
			color: inherit;
			text-decoration: none;
			transition: padding 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
		}
		.post-index {
			font-size: 0.9rem;
			font-variant-numeric: tabular-nums;
			color: #a08b68;
			transition: color 220ms ease;
		}
		.post-title {
			margin: 0 0 0.35rem;
			font-size: clamp(1.1rem, 2vw, 1.45rem);
			font-weight: 600;
			line-height: 1.3;
			color: #3d2f1e;
			transition: color 220ms ease, transform 260ms ease;
		}
		.post-date {
			margin: 0 0 0.35rem;
			font-size: 0.85rem;
			color: #a08b68;
		}
		.post-desc {
			margin: 0;
			font-size: 0.97rem;
			color: #8a7a5f;
		}
		.post-arrow {
			font-size: 1.4rem;
			color: #a08b68;
			opacity: 0;
			transform: translateX(-8px);
			transition: opacity 240ms ease, transform 240ms ease, color 240ms ease;
		}
		.post-item a:hover {
			padding-left: 1rem;
			padding-right: 0;
		}
		.post-item a:hover .post-index {
			color: var(--accent);
		}
		.post-item a:hover .post-title {
			color: var(--accent);
			transform: translateX(4px);
		}
		.post-item a:hover .post-arrow {
			opacity: 1;
			transform: translateX(0);
			color: var(--accent);
		}

		.reveal {
			opacity: 0;
			transform: translateY(18px);
			transition: opacity 700ms ease, transform 700ms ease;
		}
		.reveal.is-visible {
			opacity: 1;
			transform: translateY(0);
		}

		@media (max-width: 720px) {
			.post-item a {
				grid-template-columns: 2.2rem minmax(0, 1fr);
			}
			.post-arrow {
				display: none;
			}
		}
	</style>
</html>
