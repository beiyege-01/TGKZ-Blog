---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SplitText from '../components/SplitText.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<p class="hero-eyebrow">教程 · 实战 · 本地 AI</p>
				<h1 class="hero-title">
					<SplitText as="span" text="天工开帧" />
					<span class="hero-dot">.</span>
				</h1>
				<p class="hero-sub">
					把复杂的技术，拆成一篇篇能跟着做的教程。从 GitHub 项目到本地大模型，
					从 TTS 到 GPU 加速——动手，才是学会的唯一方式。
				</p>
				<div class="hero-cta">
					<a class="cta-link" href="/blog">
						<SplitText as="span" text="查看全部教程" />
						<span class="arrow">→</span>
					</a>
				</div>
			</section>

			<section class="posts">
				<div class="section-head reveal">
					<p class="section-label">SELECTED TUTORIALS</p>
					<p class="section-count">{String(posts.length).padStart(2, '0')}</p>
				</div>
				<ul class="post-list">
					{
						posts.map((post, index) => (
							<li class="post-item reveal">
								<a href={`/blog/${post.id}/`}>
									<span class="post-index">{String(index + 1).padStart(2, '0')}</span>
									<div class="post-body">
										<h2 class="post-title">{post.data.title}</h2>
										<p class="post-desc">{post.data.description}</p>
									</div>
									<span class="post-arrow">→</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="closing reveal">
				<p class="closing-label">FOR YOUR NEXT BUILD</p>
				<a class="closing-cta" href="/about">
					关于这个博客 <span class="arrow">→</span>
				</a>
			</section>
		</main>
		<Footer />
		<script>
			const targets = document.querySelectorAll('.reveal');
			targets.forEach((t) => t.classList.add('is-visible'));
			const observer =
				'IntersectionObserver' in window
					? new IntersectionObserver(
							(entries) => {
								entries.forEach((entry) => {
									if (entry.isIntersecting) {
										entry.target.classList.add('is-visible');
										observer.unobserve(entry.target);
									}
								});
							},
							{ threshold: 0.12 },
						)
					: null;
			targets.forEach((t) => observer?.observe(t));
		</script>
	</body>
	<style>
		main.home {
			width: min(1120px, calc(100% - 2em));
			max-width: 100%;
			margin: 0 auto;
			padding: 0 0 4em;
		}

		/* ---------- Hero ---------- */
		.hero {
			padding: clamp(4rem, 12vh, 9rem) 0 clamp(3rem, 8vh, 6rem);
			border-bottom: 1px solid var(--border);
		}
		.hero-eyebrow {
			margin: 0 0 1.6rem;
			font-size: 0.8rem;
			letter-spacing: 0.28em;
			text-transform: uppercase;
			color: var(--accent);
		}
		.hero-title {
			margin: 0;
			font-size: clamp(3rem, 9vw, 7.5rem);
			line-height: 1.02;
			letter-spacing: -0.03em;
			font-weight: 700;
		}
		.hero-dot {
			color: var(--accent);
		}
		.hero-sub {
			margin: 2rem 0 0;
			max-width: 34em;
			font-size: clamp(1.05rem, 1.6vw, 1.25rem);
			line-height: 1.75;
			color: #cbd5e1;
		}
		.hero-cta {
			margin-top: 2.6rem;
		}
		.cta-link {
			display: inline-block;
			padding: 0.9rem 1.4rem;
			border: 1px solid rgba(94, 231, 223, 0.45);
			border-radius: 999px;
			color: #d6f7f4;
			font-weight: 600;
			transition: background 220ms ease, color 220ms ease, transform 220ms ease;
		}
		.cta-link:hover {
			background: var(--accent);
			color: #052e2b;
			transform: translateY(-2px);
		}
		.cta-link .arrow {
			display: inline-block;
			transition: transform 220ms ease;
		}
		.cta-link:hover .arrow {
			transform: translateX(4px);
		}

		/* ---------- Posts ---------- */
		.posts {
			padding: clamp(2.5rem, 6vh, 4.5rem) 0;
		}
		.section-head {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			padding-bottom: 1.2rem;
			border-bottom: 1px solid var(--border);
		}
		.section-label {
			margin: 0;
			font-size: 0.78rem;
			letter-spacing: 0.26em;
			text-transform: uppercase;
			color: #94a3b8;
		}
		.section-count {
			margin: 0;
			font-size: 0.85rem;
			color: #64748b;
			font-variant-numeric: tabular-nums;
		}
		.post-list {
			list-style: none;
			margin: 0;
			padding: 0;
		}
		.post-item {
			border-bottom: 1px solid var(--border);
		}
		.post-item a {
			display: grid;
			grid-template-columns: 3rem minmax(0, 1fr) auto;
			align-items: center;
			gap: 1.2rem;
			padding: 1.9rem 0.4rem;
			color: inherit;
			text-decoration: none;
			transition: padding 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
		}
		.post-index {
			font-size: 0.9rem;
			font-variant-numeric: tabular-nums;
			color: #64748b;
			transition: color 220ms ease;
		}
		.post-title {
			margin: 0 0 0.4rem;
			font-size: clamp(1.15rem, 2.2vw, 1.6rem);
			font-weight: 600;
			line-height: 1.3;
			letter-spacing: -0.01em;
			color: #f8fafc;
			transition: color 220ms ease, transform 260ms ease;
		}
		.post-desc {
			margin: 0;
			font-size: 0.98rem;
			color: #94a3b8;
		}
		.post-arrow {
			font-size: 1.4rem;
			color: #64748b;
			opacity: 0;
			transform: translateX(-8px);
			transition: opacity 240ms ease, transform 240ms ease, color 240ms ease;
		}
		.post-item a:hover {
			padding-left: 1rem;
			padding-right: 0;
		}
		.post-item a:hover .post-index {
			color: var(--accent);
		}
		.post-item a:hover .post-title {
			color: var(--accent);
			transform: translateX(4px);
		}
		.post-item a:hover .post-arrow {
			opacity: 1;
			transform: translateX(0);
			color: var(--accent);
		}

		/* ---------- Closing ---------- */
		.closing {
			padding: clamp(3rem, 8vh, 5.5rem) 0 1rem;
			text-align: center;
		}
		.closing-label {
			margin: 0 0 1.4rem;
			font-size: 0.78rem;
			letter-spacing: 0.28em;
			text-transform: uppercase;
			color: #64748b;
		}
		.closing-cta {
			font-size: clamp(1.3rem, 3vw, 2rem);
			font-weight: 600;
			color: #f8fafc;
			text-decoration: none;
			transition: color 220ms ease;
		}
		.closing-cta:hover {
			color: var(--accent);
		}
		.closing-cta .arrow {
			display: inline-block;
			transition: transform 220ms ease;
		}
		.closing-cta:hover .arrow {
			transform: translateX(6px);
		}

		/* ---------- Reveal ---------- */
		.reveal {
			opacity: 0;
			transform: translateY(18px);
			transition: opacity 700ms ease, transform 700ms ease;
		}
		.reveal.is-visible {
			opacity: 1;
			transform: translateY(0);
		}

		@media (max-width: 720px) {
			.post-item a {
				grid-template-columns: 2.2rem minmax(0, 1fr);
			}
			.post-arrow {
				display: none;
			}
			.hero {
				padding: 3.5rem 0 3rem;
			}
		}
	</style>
</html>
