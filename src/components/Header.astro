---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">教程列表</HeaderLink>
			<HeaderLink href="/gallery">相册</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 1rem 1.4rem;
		backdrop-filter: blur(16px);
		background: rgba(216, 205, 180, 0.82);
		border-bottom: 1px solid rgba(96, 66, 36, 0.3);
		position: sticky;
		top: 0;
		z-index: 20;
	}
	h2 {
		margin: 0;
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.02em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
		color: #3d2f1e;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1140px;
		margin: 0 auto;
	}
	nav a {
		padding: 0.7em 0.9em;
		color: #6b5638;
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-size: 0.96rem;
		transition: color 200ms ease, border-color 200ms ease;
	}
	nav a:hover,
	nav a.active {
		text-decoration: none;
		color: #3d2f1e;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		gap: 0.2rem;
	}
	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.6rem;
		}
	}
</style>
